{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "archaeo·pro",
  "version": "0.1.0",
  "identifier": "pro.archaeo.app",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build -- --configuration=production",
    "frontendDist": "../dist/archaeo-pro/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "archaeo·pro",
        "width": 420,
        "height": 880,
        "resizable": true
      }
    ],
    "security": {
      "comment": "CSP left null for v1: the app legitimately loads from many origins (GitHub API + uploads, Vercel API, OSM/WMS tiles, Google Fonts, archaeo.pro). Tighten in a hardening pass — see docs/mobile.md.",
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Sorveglianze archeologiche sul campo.",
    "longDescription": "archaeo·pro per il campo: rilievo su mappa, scatto foto e compilazione del giornale di scavo, pronti per generare la relazione per la Soprintendenza."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["archaeopro"]
      },
      "mobile": [
        { "scheme": "archaeopro", "host": "auth-callback" }
      ]
    }
  }
}
